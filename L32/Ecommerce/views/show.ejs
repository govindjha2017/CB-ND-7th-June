<%- layout("layout/boilerplate.ejs") %>

<div class="row">
    <div id="def" class="col-6">
        <div class="card abc" >
            <img height="260px" src=<%= product.image %> class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title"><%= product.name %></h5>
                <h5 class="card-title">$<%= product.price %></h5>
                <p class="card-text"><%= product.desc %></p>
                <%if(currUser && currUser.role=="seller"){%>
                    <a href="/products/<%= product._id %>/edit" class="btn btn-primary">Edit</a>
                    <form id="form-delete" action="/products/<%= product._id %>?_method=delete"  method="post">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                <%}%>
                <a href="#" class="btn btn-success">Add to cart</a>
            </div>
        </div>
    </div>
    <div id="abc" class="col-6">
            <h1>Reviews:</h1>

            <form action="/products/<%= product._id %>/reviews" method="post">
                <!-- <input type="range" min="0" max="5" name="rating"> -->
                <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value=0 checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="rating" value=1 />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="rating" value=2 />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="rating" value=3 />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="rating" value=4 />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="rating" value=5 />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                <textarea name="comment" rows="4" cols="30">

                </textarea>
                <br>
                <button class="btn btn-success">submit</button>
            </form>

            <div>
                <% for(let review of product.reviews){ %>
                    <div class="card" style="width: 250px; margin-top: 20px;">
                        <div class="card-header">
                            <p class="starability-result" data-rating=<%= review.rating %> ></p>
                        </div>
                        <div class="card-body">
                            <%= review.comment %>
                        </div>
                    </div>
                <% } %>
            </div>
    </div>
</div>